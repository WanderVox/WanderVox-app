<?xml version="1.0" encoding="utf-8"?>
<!--
    Canvas del foreground adaptativo: 108dp. Los launchers solo garantizan visible un círculo de
    66dp en el centro. El pin ocupa ~91% del alto de la imagen, así que con 28dp de inset mide
    ~47dp y queda con margen (~9dp) dentro del círculo seguro en cualquier máscara.
    Sin android:gravity: con gravity, LayerDrawable dibuja el bitmap a su tamaño intrínseco en
    lugar de escalarlo al área del inset.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/app_icon_source"
        android:top="28dp"
        android:bottom="28dp"
        android:left="28dp"
        android:right="28dp" />
</layer-list>
